# Aangan Studio phone agent. Copy these into .env.local (or Vercel env vars).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash        # if you change it, also set the two prices below (USD per 1M tokens)
# GEMINI_IN_USD_PER_M=0.30
# GEMINI_OUT_USD_PER_M=2.50
USD_INR=88
VAANI_INR_PER_MIN=5                    # ASSUMPTION: set to the Vaani contract rate
VOICE_WEBHOOK_SECRET=                  # shared secret Vaani sends (x-webhook-secret header, Bearer, or ?secret=)
STUDIO_KEY=                            # required in production; open the dashboard with /studio?key=...
CAL_API_KEY=
CAL_EVENT_TYPE_ID=                     # a round-robin event type across designers
CAL_FALLBACK_EMAIL=                    # attendee email when the caller gives none (Cal.com requires one)
RESEND_API_KEY=
HANDOFF_FROM_EMAIL=                    # leave empty while testing: Resend's sandbox sender can only deliver to the Resend account owner's own email
DESIGNER_EMAILS=                       # comma-separated; qualified leads. For testing, put your own email here
FRONT_DESK_EMAILS=                     # comma-separated; "needs review" leads (and cc on qualified)
# SUPABASE_URL / SUPABASE_SECRET_KEY: run supabase/studio.sql. Without them calls are kept in .data/ (dev only).
FOUNDER_EMAILS=                        # for testing: your own email; every AI-rejected call is emailed here with the transcript + review link
HUBSPOT_TOKEN=                         # private app token (CRM deals/contacts/notes write + schema write for setup)
HUBSPOT_PIPELINE_ID=                   # printed by: npm run hubspot:setup
APP_URL=                               # public URL of this app (Vercel), used in review links
REVIEW_SECRET=                         # signs per-call review links (falls back to STUDIO_KEY)
